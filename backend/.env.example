# Gemini / ADK
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
GEOAGENT_ADK_LOG_LEVEL=INFO
GEOAGENT_OTEL_TO_CLOUD=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
OTEL_INSTRUMENTATION_GENAI_EMIT_EVENT=false
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Google Cloud
GOOGLE_CLOUD_PROJECT=geoagent-hackathon
FIRESTORE_DATABASE_ID=geoagentdb

# Use local for development and gcs in Cloud Run.
GEOAGENT_SOURCE_STORAGE=local
GEOAGENT_SOURCE_BUCKET=
GEOAGENT_LOCAL_SOURCE_DIRECTORY=data/sources
GEOAGENT_MAX_SQLITE_UPLOAD_BYTES=26214400
GEOAGENT_MAX_LLM_CALLS=100
GEOAGENT_QA_MAX_LLM_CALLS=8
GEOAGENT_QA_TIMEOUT_SECONDS=90
GEOAGENT_PRIMARY_MODEL=gemini-3.6-flash
GEOAGENT_FALLBACK_MODELS=gemini-3.5-flash

# Comma-separated browser origins. Set this to the deployed frontend origin in Cloud Run.
GEOAGENT_CORS_ORIGINS=http://localhost:5173
